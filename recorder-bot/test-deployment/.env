# Local test deployment for the recorder bot. Not for production: the passwords below are fixed and public.
# Values here are read by docker-compose.yml; see README.md.

CONFIG=./config
HTTP_PORT=8000
HTTPS_PORT=8443
TZ=UTC
PUBLIC_URL=https://localhost:8443

JITSI_IMAGE_VERSION=stable

# The deployment settings the recorder bot needs (recorder-bot/deploy/README.md).
ENABLE_P2P=false
RESOLUTION=720
ENABLE_RECORDING=1
XMPP_HIDDEN_DOMAIN=recorder.meet.jitsi
JIBRI_RECORDER_USER=recorder-bot
JIBRI_RECORDER_PASSWORD=recorder-bot-test-password

# Browsers run on the host and reach JVB through the mapped UDP port.
JVB_ADVERTISE_IPS=127.0.0.1
JVB_DISABLE_STUN=true

# The e2e suite joins without the prejoin and welcome pages.
ENABLE_PREJOIN_PAGE=false
ENABLE_WELCOME_PAGE=false
DISABLE_DEEP_LINKING=true

# This sandbox-friendly default avoids binding IPv6.
ENABLE_IPV6=0

JICOFO_AUTH_PASSWORD=jicofo-test-password
JVB_AUTH_PASSWORD=jvb-test-password
JIGASI_XMPP_PASSWORD=unused
JIGASI_TRANSCRIBER_PASSWORD=unused
JIBRI_XMPP_PASSWORD=jibri-test-password

# The recorder bot service.
RECORDER_BOT_API_PORT=8090
RECORDER_BOT_API_SECRET=recorder-bot-test-secret
# Enough that tests never meet the limit; the limited instance on RECORDER_BOT_LIMITED_API_PORT has a limit of one.
RECORDER_BOT_MAX_CONSULTATIONS=4
RECORDER_BOT_LIMITED_API_PORT=8091
# How often a crashed bot is relaunched; the fragile instance on RECORDER_BOT_FRAGILE_API_PORT never relaunches it.
RECORDER_BOT_MAX_RELAUNCHES=3
RECORDER_BOT_FRAGILE_API_PORT=8092
# Short timers, so that the e2e tests do not wait long. expectations.json must match.
RECORDER_BOT_EMPTY_ROOM_GRACE_SECONDS=10
RECORDER_BOT_FIRST_JOIN_WAIT_SECONDS=20
# Which verified identities are staff and which the patient. Only the JWT variant (docker-compose.jwt.yml) verifies
# identities; without it, every participant's role is unknown. expectations.jwt.json must match.
RECORDER_BOT_STAFF_MARKER=user.hospital_role=staff
RECORDER_BOT_PATIENT_MARKER=user.hospital_role=patient
