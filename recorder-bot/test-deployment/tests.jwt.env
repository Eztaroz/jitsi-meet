# Settings for running the WebdriverIO suite (tests/) against the JWT variant of the test deployment
# (docker-compose.jwt.yml). From tests/, after tests.env:
#   set -a; . ../recorder-bot/test-deployment/tests.env; . ../recorder-bot/test-deployment/tests.jwt.env; set +a
#   npm run test-single -- specs/recorderBot/identity.spec.ts
# Relative to tests/, where the suite runs.
EXPECTATIONS=../recorder-bot/test-deployment/expectations.jwt.json
# The key pair from jwt/generate-keys.sh; Prosody has the public key.
JWT_KID=recorder-bot-test/jwt
JWT_PRIVATE_KEY_PATH=../recorder-bot/test-deployment/jwt/private.pem
