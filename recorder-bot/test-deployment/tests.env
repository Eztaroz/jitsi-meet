# Settings for running the WebdriverIO suite (tests/) against this test deployment. From tests/:
#   set -a; . ../recorder-bot/test-deployment/tests.env; set +a
#   npm run test-single -- specs/recorderBot/hiddenBot.spec.ts
BASE_URL=https://localhost:8443/
ALLOW_INSECURE_CERTS=true
HEADLESS=true
# Relative to tests/, where the suite runs.
EXPECTATIONS=../recorder-bot/test-deployment/expectations.json
RECORDER_BOT_API_URL=http://localhost:8090
RECORDER_BOT_API_SECRET=recorder-bot-test-secret
# The instance limited to one consultation at a time, for the capacity tests.
RECORDER_BOT_LIMITED_API_URL=http://localhost:8091
# The service's evidence storage root (./evidence here, mounted into its container), relative to tests/.
RECORDER_BOT_STORAGE_ROOT=../recorder-bot/test-deployment/evidence
# The instance that never relaunches a crashed bot, for the relaunch tests.
RECORDER_BOT_FRAGILE_API_URL=http://localhost:8092
# The container the main and the fragile instances run in, so that the relaunch tests can kill a bot's browser.
RECORDER_BOT_CONTAINER=recorder-bot-test-recorder-bot-1
RECORDER_BOT_FRAGILE_CONTAINER=recorder-bot-test-recorder-bot-fragile-1
# The instance whose storage root the storage tests take away and give back (./outage/evidence here, relative to
# tests/), its spool, its container, and how often it retries, in seconds.
RECORDER_BOT_OUTAGE_API_URL=http://localhost:8093
RECORDER_BOT_OUTAGE_STORAGE_ROOT=../recorder-bot/test-deployment/outage/evidence
RECORDER_BOT_OUTAGE_SPOOL=../recorder-bot/test-deployment/spool/outage
RECORDER_BOT_OUTAGE_CONTAINER=recorder-bot-test-recorder-bot-outage-1
RECORDER_BOT_OUTAGE_STORE_RETRY_SECONDS=2
