# Settings for running the WebdriverIO suite (tests/) against this test deployment. From tests/:
#   set -a; . ../recorder-bot/test-deployment/tests.env; set +a
#   npm run test-single -- specs/recorderBot/hiddenBot.spec.ts
BASE_URL=https://localhost:8443/
ALLOW_INSECURE_CERTS=true
HEADLESS=true
# Relative to tests/, where the suite runs.
EXPECTATIONS=../recorder-bot/test-deployment/expectations.json
RECORDER_BOT_API_URL=http://localhost:8090
RECORDER_BOT_API_SECRET=recorder-bot-test-secret
# The service's evidence storage root (./evidence here, mounted into its container), relative to tests/.
RECORDER_BOT_STORAGE_ROOT=../recorder-bot/test-deployment/evidence
