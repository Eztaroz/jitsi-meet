# Local test stack for the recorder-bot prototype. Not for production.
# CONFIG is overridden on the command line (see ../README.md).
CONFIG=./cfg
HTTP_PORT=8000
HTTPS_PORT=8443
TZ=UTC
PUBLIC_URL=https://localhost:8443

# ADR 0002: no P2P, media always goes through JVB.
ENABLE_P2P=false

# Creates the hidden VirtualHost and registers the bot account
# (JIBRI_RECORDER_USER@XMPP_HIDDEN_DOMAIN). No Jibri container is started.
ENABLE_RECORDING=1
XMPP_HIDDEN_DOMAIN=recorder.meet.jitsi
JIBRI_RECORDER_USER=recbot
JIBRI_RECORDER_PASSWORD=recbot-prototype-pass

# Browsers run on the host and reach JVB through the mapped UDP port.
JVB_ADVERTISE_IPS=127.0.0.1
JVB_DISABLE_STUN=true

ENABLE_PREJOIN_PAGE=false
ENABLE_WELCOME_PAGE=false

JICOFO_AUTH_PASSWORD=jicofo-prototype-pass
JVB_AUTH_PASSWORD=jvb-prototype-pass
JIGASI_XMPP_PASSWORD=unused
JIGASI_TRANSCRIBER_PASSWORD=unused
JIBRI_XMPP_PASSWORD=jibri-prototype-pass

# Images pulled from Docker Hub.
JITSI_IMAGE_REPO=jitsi
JITSI_IMAGE_VERSION=stable

# Docker Hub web image listens on 80/443 and this sandbox has no IPv6.
ENABLE_IPV6=0
