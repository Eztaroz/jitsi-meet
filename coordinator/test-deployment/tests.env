# Settings for running the WebdriverIO suite's specs/coordinator tests against the coordinator test deployment. From
# tests/, after the recorder bot's own tests.env and tests.jwt.env:
#   set -a; . ../recorder-bot/test-deployment/tests.env; . ../recorder-bot/test-deployment/tests.jwt.env
#   . ../coordinator/test-deployment/tests.env; set +a
#   npm run test-single -- 'specs/coordinator/*.spec.ts'
COORDINATOR_API_URL=http://localhost:8094
COORDINATOR_API_SECRET=coordinator-test-secret
COORDINATOR_CONTAINER=recorder-bot-test-coordinator-1
