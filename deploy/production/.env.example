# Settings of the production deployment (docker-compose.yml). Copy it to .env with scripts/generate-secrets.sh, which
# also fills every CHANGE_ME secret with a random one and renders coturn/turnserver.conf. Never commit .env.

# --- Where it is -------------------------------------------------------------------------------------------------

# The public name and URL of the deployment, as the hospital's systems and the users know them.
PUBLIC_HOST=telemedicine.example.org
PUBLIC_URL=https://telemedicine.example.org

# This host's address on the internal network (the new host's own). The recorder bot and the video player resolve
# PUBLIC_HOST to it, so they reach the web server and the videobridge without a detour through the NAT.
HOST_INTERNAL_IP=CHANGE_ME_INTERNAL_IP

# The videobridge's advertised addresses, comma-separated: this host's own, then the NAT's public one.
# The old server maps 192.0.2.10 to 203.0.113.10.
JVB_ADVERTISE_IPS=CHANGE_ME_INTERNAL_IP,203.0.113.10

# The public address of the host, for coturn's relay.
EXTERNAL_IP=203.0.113.10

HTTP_PORT=80
HTTPS_PORT=443
TZ=Asia/Bangkok
ENABLE_IPV6=0

# --- TLS ---------------------------------------------------------------------------------------------------------

# The full chain and the key, readable by root only (chmod 600 on the key). The web server and coturn read them.
TLS_CERT_FILE=/etc/ssl/tele-meet/fullchain.crt
TLS_KEY_FILE=/etc/ssl/tele-meet/private.key

# --- Images ------------------------------------------------------------------------------------------------------

# Pin the docker-jitsi-meet tag the end-to-end suite passed on (the test deployment uses "stable"); never "latest".
JITSI_IMAGE_VERSION=CHANGE_ME_IMAGE_TAG
COTURN_IMAGE=coturn/coturn:4.6.3
FRONT_IMAGE=front:CHANGE_ME_VERSION
RECORDER_BOT_IMAGE=recorder-bot:CHANGE_ME_VERSION
COORDINATOR_IMAGE=coordinator:CHANGE_ME_VERSION
VIDEO_PLAYER_IMAGE=video-player:CHANGE_ME_VERSION

# --- Tokens (JWT-CONTRACT.md) -------------------------------------------------------------------------------------

# The hospital issuer's "iss" and the token audience. Prosody's app_id is the issuer's.
HOSPITAL_JWT_ISSUER=tele-med
JWT_APP_ID=tele-med
JWT_AUDIENCE=jitsi

# Role markers, as "user.<claim>=<value>" for a claim in the token's context.user, or "group=<value>".
PATIENT_MARKER=user.hospital_role=patient
STAFF_MARKER=user.hospital_role=staff
COORDINATOR_MARKER=user.hospital_role=coordinator
VIDEO_PLAYER_MARKER=user.hospital_role=video_player

# The coordinator service's key id (the key pair is made by scripts/generate-keys.sh).
COORDINATOR_SIGNING_KID=coordinator/key-1

# --- Recording ---------------------------------------------------------------------------------------------------

XMPP_HIDDEN_DOMAIN=recorder.meet.jitsi
JIBRI_RECORDER_USER=recorder-bot

# The evidence storage root: the hospital's file storage, mounted on this host. Create the marker file once, on the
# share itself while it is mounted:  touch "$RECORDER_BOT_STORAGE_ROOT/.recorder-bot-storage-root"
# The recorder bot runs as uid 1001, which must be able to write there.
RECORDER_BOT_STORAGE_ROOT=/mnt/evidence

# Cores divided by the measured cores per consultation, leaving at least 25% free; until a real-camera measurement is
# written down in recorder-bot/deploy/README.md (Capacity), about half the host's cores.
RECORDER_BOT_MAX_CONSULTATIONS=CHANGE_ME_HALF_THE_CORES
# The tallest video the recorder bot asks the videobridge for, and so records. Below 720 it records 360 lines and
# takes about 0.2 of a core per consultation instead of about three (recorder-bot/deploy/README.md).
RECORDER_BOT_MAX_HEIGHT=720
VIDEO_PLAYER_MAX_ROOMS=3

# How long encounters, surveys, audit entries and evidence recordings are kept.
RETENTION_DAYS=90

# --- Secrets (scripts/generate-secrets.sh) ------------------------------------------------------------------------

JICOFO_AUTH_PASSWORD=CHANGE_ME
JVB_AUTH_PASSWORD=CHANGE_ME
JIBRI_RECORDER_PASSWORD=CHANGE_ME
JIBRI_XMPP_PASSWORD=CHANGE_ME
JIGASI_XMPP_PASSWORD=CHANGE_ME
JIGASI_TRANSCRIBER_PASSWORD=CHANGE_ME
TURN_CREDENTIALS=CHANGE_ME
RECORDER_BOT_API_SECRET=CHANGE_ME
VIDEO_PLAYER_API_SECRET=CHANGE_ME
COORDINATOR_API_SECRET=CHANGE_ME
COORDINATOR_AUDIT_KEY=CHANGE_ME

# The coordinator service's state. Left empty, it is kept in SQLite in the coordinator-data volume. To keep it in the
# hospital's MariaDB instead, ask the database team for a schema and a user (coordinator/deploy/README.md, "State in
# MariaDB"), fill these in, and move what is in the volume with the one-off copy command described there.
COORDINATOR_MARIADB_HOST=
COORDINATOR_MARIADB_PORT=3306
COORDINATOR_MARIADB_DATABASE=
COORDINATOR_MARIADB_USER=
COORDINATOR_MARIADB_PASSWORD=
